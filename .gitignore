# Python/tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.coverage*
htmlcov/
.idea/
.vscode/

# Environments and packaging
.env
.venv/
env/
venv/
build/
dist/
*.egg-info/

# Runtime state and scientific outputs
results/
output/
outputs/
runs/
campaigns/
scratch/
tmp/
logs/
diagnostics/
benchmarks/results/
validation/results/
generated_ML_inputs/
mols/
raw_1h/
raw_13c/
predicted_spectra_1H/
predicted_spectra_13C/
bucketed_1H_spectra/
bucketed_13C_spectra/
merged/
attempt_history/
production_progress.txt
checkpoint.json
summary.json
failures.jsonl
run_manifest.json
*.log
*.tmp

# Input/output datasets are never source artifacts. The tracked example is
# explicitly retained below.
*.csv
!input_example.csv
!validation/*.csv
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite3-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.parquet
*.npy
*.npz

# Java compilation is hash-aware and uses an external build cache.
*.class
java_build/
.demiurge-*/

# Immutable, hash-pinned scientific validation fixtures are source artifacts.
!validation/frozen_nmr_v2_expected/
!validation/frozen_nmr_v2_expected/**
